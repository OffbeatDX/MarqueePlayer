[Desktop Entry]
Type=Application
Name=Marquee Player
GenericName=Music Player
Comment=Play your music library, artwork first
Exec=MarqueePlayer %F
Icon=app.marqueeplayer.MarqueePlayer
Terminal=false
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;audio;player;library;album;playlist;flac;opus;mp3;lyrics;scrobble;
StartupNotify=true
StartupWMClass=app.marqueeplayer.MarqueePlayer
SingleMainWindow=true
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp3;audio/x-mp3;audio/x-mpeg;audio/mp2;audio/x-mp2;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/aiff;audio/x-aiff;audio/x-aifc;audio/aac;audio/x-aac;audio/mp4;audio/x-m4a;audio/x-m4b;
