# What the tree already does (https://editorconfig.org). Line endings as in .gitattributes:
# LF in the repository, CRLF for batch files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.{rs,slint}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
