<resources>
    <!-- Only the window before Compose draws; the look itself is in ui/Theme.kt. -->
    <style name="Theme.Marquee" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
    </style>
    <color name="bg">#0C0B10</color>
    <color name="accent">#B4A6E8</color>
</resources>
