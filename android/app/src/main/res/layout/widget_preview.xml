<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (API 31+ previewLayout): the compact widget, playing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_preview_cover"
        android:contentDescription="@null"
        android:padding="12dp"
        android:src="@drawable/widget_album"
        android:tint="#FF928DA0" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFF3F0F7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_subtitle"
            android:textColor="#FFA9A3B6"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_preview_play"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/widget_pause"
        android:tint="#FF1B1726" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/widget_next"
        android:tint="#FFA9A3B6" />
</LinearLayout>
