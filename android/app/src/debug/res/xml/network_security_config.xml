<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only. Everything stays https-only except the loopback address, where a local stand-in for
     LRCLIB can be reached through `adb reverse` (lrclib.net itself is never contacted by test builds). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
